NEXT_PUBLIC_AGENT_USE_REAL_API=1
# 本地 dev 直连远程：PROXY=0，ORIGIN 须与线上浏览器里看到的 API 根一致（含 /agent-platform）。
NEXT_PUBLIC_AGENT_API_USE_PROXY=0
# 线上登录为 http://www.mdata.xin/agent-platform/api/auth/login → 根路径要带 /agent-platform
NEXT_PUBLIC_AGENT_API_ORIGIN=http://www.mdata.xin/agent-platform
# 不配时由 ORIGIN 推导为 ws://www.mdata.xin/agent-platform；若远程 WS 路径不同再显式覆盖
#NEXT_PUBLIC_AGENT_WS_ORIGIN=ws://www.mdata.xin/agent-platform
# 只有用 http://10.20.2.155:3000 这类地址打开本机 dev 时才需要；一直用 127.0.0.1 可不配。
#NEXT_DEV_ALLOWED_ORIGINS=10.20.2.155
