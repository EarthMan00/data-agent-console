NEXT_PUBLIC_AGENT_USE_REAL_API=1
# 本地控制台 -> 远程 API：直连远程服务，不走本机 Next 代理。
NEXT_PUBLIC_AGENT_API_USE_PROXY=0
# 与浏览器可访问的远程 API 根一致。
NEXT_PUBLIC_AGENT_API_ORIGIN=http://www.mdata.xin/agent-platform
# 多步任务 WS 如需单独配置，再补充远程 WS 入口。
#NEXT_PUBLIC_AGENT_WS_ORIGIN=
# 只有用 http://10.20.2.155:3000 这类地址打开本机 dev 时才需要；一直用 127.0.0.1 可不配。
#NEXT_DEV_ALLOWED_ORIGINS=10.20.2.155
