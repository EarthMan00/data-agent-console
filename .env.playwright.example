# Frontend host/port used by Playwright webServer
PLAYWRIGHT_HOST=127.0.0.1
PLAYWRIGHT_PORT=3000

# Timeout for each preflight HTTP step in milliseconds
PLAYWRIGHT_PREFLIGHT_TIMEOUT_MS=15000

# Admin credentials used for auth seeding and fixture setup
PLAYWRIGHT_ADMIN_USERNAME=admin
PLAYWRIGHT_ADMIN_PASSWORD=admin123

# Prefix used in generated share/favorite/feedback fixture names
PLAYWRIGHT_FIXTURE_PREFIX=E2E

# Feedback fixture cleanup behavior
PLAYWRIGHT_FEEDBACK_STATUS=archived
PLAYWRIGHT_FEEDBACK_NOTE=playwright e2e fixture
