# Browser-side API access
NEXT_PUBLIC_AGENT_API_USE_PROXY=1
NEXT_PUBLIC_AGENT_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_AGENT_BACKEND_PORT=8000
NEXT_PUBLIC_AGENT_WS_ORIGIN=ws://127.0.0.1:8000

# App limits
NEXT_PUBLIC_TASK_NAME_MAX_CHARS=32
NEXT_PUBLIC_CHAT_MESSAGE_MAX_CHARS=100000

# Server-side proxy target for Next.js route handlers / proxy routes
AGENT_WEB_PLATFORM_INTERNAL_URL=http://127.0.0.1:8000
